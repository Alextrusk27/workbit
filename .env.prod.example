# Шаблон .env для compose.prod.yml. На сервере лежит как /opt/workbit/.env (chmod 600).
# Все переменные ниже обязательны: без любой из них приложение не стартует.

POSTGRES_DB=workbit_db
POSTGRES_USER=workbit
POSTGRES_PASSWORD=

# Ставится деплоем: cr.yandex/<registry-id>/workbit-backend:<sha>
BACKEND_IMAGE=

# Не короче 32 символов — иначе приложение поднимется, но первый же вход упадёт с 500
JWT_SECRET=
MAIL_PASSWORD=

YANDEX_FOLDER_ID=
YANDEX_API_KEY=

HH_USER_AGENT=
HH_APP_TOKEN=

# Идентификаторы промптов в Yandex AI Studio
TQG_NOEXP=
TQG_JUNIOR=
TQG_MIDDLE=
TQG_SENIOR=
TRAINING_REVIEWER=
TRAINING_REFERENCE_ANSWER=
IQG_EXP0=
IQG_EXP1=
IQG_EXP3=
IQG_EXP6=
IFU_EXP0=
IFU_EXP1=
IFU_EXP3=
IFU_EXP6=
IRV_EXP0=
IRV_EXP1=
IRV_EXP3=
IRV_EXP6=
INPUT_NORMALIZER=
