workbit.ru {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/workbit.key

	handle /api/v1/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@rest not path /assets/*
		header @rest Cache-Control "no-cache"
		file_server
	}
}

www.workbit.ru {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/workbit.key

	redir https://workbit.ru{uri} permanent
}
